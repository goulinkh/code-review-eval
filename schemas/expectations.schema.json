{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:code-review-eval:schema:expectations:1.0.0",
  "title": "Grader-only fixture expectations; never sent to reviewer",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "$ref": "urn:code-review-eval:schema:common:1.0.0#/$defs/case_id"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "enum": [
            "development",
            "held-out"
          ]
        },
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "related_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "$ref": "urn:code-review-eval:schema:common:1.0.0#/$defs/case_id"
              },
              "relationship": {
                "enum": [
                  "defect-fix",
                  "adversarial-variant",
                  "checkpoint",
                  "semantic-variant"
                ]
              }
            },
            "required": [
              "case_id",
              "relationship"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "version",
        "partition",
        "group_id",
        "related_cases"
      ],
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "primary_concern": {
          "enum": [
            "functional-correctness",
            "integration-compatibility",
            "security",
            "reliability-state",
            "performance-resources",
            "tests-verification",
            "maintainability-conventions"
          ]
        },
        "secondary_concerns": {
          "type": "array",
          "items": {
            "enum": [
              "functional-correctness",
              "integration-compatibility",
              "security",
              "reliability-state",
              "performance-resources",
              "tests-verification",
              "maintainability-conventions"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "change_outcome": {
          "enum": [
            "defective",
            "clean",
            "undetermined"
          ]
        }
      },
      "required": [
        "languages",
        "primary_concern",
        "secondary_concerns",
        "change_outcome"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "original",
            "derived"
          ]
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "fix_revision": {
                "type": "string",
                "minLength": 1
              },
              "parent_revision": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "$ref": "urn:code-review-eval:schema:common:1.0.0#/$defs/path"
                },
                "minItems": 1
              },
              "synthesis": {
                "enum": [
                  "faithful-reduction",
                  "inspired-mutation"
                ]
              },
              "changes": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "repository",
              "fix_revision",
              "parent_revision",
              "paths",
              "synthesis",
              "changes"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "verification": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "independently-reviewed"
              ]
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "licence",
        "permission",
        "sources",
        "verification"
      ],
      "additionalProperties": false
    },
    "expectations": {
      "type": "object",
      "properties": {
        "required_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "severity_rationale": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "type": "array",
                "items": {
                  "$ref": "urn:code-review-eval:schema:common:1.0.0#/$defs/location"
                },
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "manual-scenario",
                        "reproducer"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "discoverable_because": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "explanation",
              "severity",
              "severity_rationale",
              "locations",
              "evidence",
              "discoverable_because"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "non_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "allegation": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "allegation",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "context": {
          "type": "object",
          "properties": {
            "condition": {
              "enum": [
                "self-contained",
                "project-dependent",
                "insufficient"
              ]
            },
            "expected_behavior": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "condition",
            "expected_behavior"
          ],
          "additionalProperties": false
        },
        "retrieval": {
          "type": "object",
          "properties": {
            "requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptable_sources": {
                    "type": "array",
                    "items": {
                      "$ref": "urn:code-review-eval:schema:common:1.0.0#/$defs/source"
                    },
                    "minItems": 1
                  },
                  "evidence_origin": {
                    "enum": [
                      "available-evidence",
                      "new-suffix"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "acceptable_sources",
                  "evidence_origin",
                  "rationale"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "soft_budget": {
              "type": "object",
              "properties": {
                "repository_read_attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "returned_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "repeated_reads": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "repository_read_attempts",
                "returned_bytes",
                "repeated_reads"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requirements",
            "soft_budget"
          ],
          "additionalProperties": false
        },
        "continuation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "required_remaining_actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "forbidden_actions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                },
                "essential_order": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "before": {
                        "type": "string",
                        "minLength": 1
                      },
                      "after": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "before",
                      "after"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "acceptable_alternatives": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "required_remaining_actions",
                "forbidden_actions",
                "essential_order",
                "acceptable_alternatives"
              ],
              "additionalProperties": false
            }
          ]
        },
        "instruction_handling": {
          "type": "object",
          "properties": {
            "expected_behavior": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "expected_behavior"
          ],
          "additionalProperties": false
        },
        "final_review_behavior": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required_findings",
        "non_findings",
        "context",
        "retrieval",
        "continuation",
        "instruction_handling",
        "final_review_behavior"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "revision",
    "input_sha256",
    "dataset",
    "labels",
    "provenance",
    "expectations"
  ],
  "additionalProperties": false
}
